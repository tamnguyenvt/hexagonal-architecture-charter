      }
    },
    {
      "do": {
        "touchFile": "main.js"
      },
      "expect": {
        "activate": "hexagonal-architecture"
      }
    },
    {
      "do": {
        "touchFile": "src/hexagon/port/zdriven/ForReadingFiles.ts"
      },
      "expect": {
